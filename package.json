{
  "name": "marching-art",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://marching.art",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.7",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "firebase-admin": "^13.10.0",
    "globals": "^17.11.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "rehearse": "npm --prefix firestore-tests exec -- firebase emulators:exec --only firestore --project demo-rehearsal --config functions/rehearsal/firebase.json 'node functions/rehearsal/run.js'",
    "rehearse:scale": "npm --prefix firestore-tests exec -- firebase emulators:exec --only firestore --project demo-rehearsal --config functions/rehearsal/firebase.json 'node functions/rehearsal/run.js --scale'",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "census": "node scripts/designCensus.mjs",
    "census:check": "node scripts/designCensus.mjs --check",
    "audit:check": "node scripts/auditRatchet.mjs",
    "ts-nocheck:check": "node scripts/tsNocheckCensus.mjs --check",
    "ts-nocheck:next": "node scripts/tsNocheckNext.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
